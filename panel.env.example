# Настройки панели стенда. Все строки необязательны: если чего-то нет,
# панель берёт значение по умолчанию из stand-ui.py.
#
# Файл читается юнитом stand-ui.service (EnvironmentFile) и лежит рядом с кодом.
# Формат — обычный для systemd: ИМЯ=значение, без кавычек, без пробелов вокруг «=».

# --- куда ходить за картинками и чатом -------------------------------------
# ComfyUI и ollama на этой же машине; если они в контейнере с пробросом портов,
# эти адреса всё равно верны, потому что порт проброшен на 127.0.0.1.
COMFY_API=http://127.0.0.1:8188
OLLAMA_API=http://127.0.0.1:11434

# 1 — ComfyUI крутится в docker на этой машине и панель может пересоздать его,
# если он потерял видеокарту (нужен docker-доступ у пользователя панели).
UI_COMFY_IN_CONTAINER=0
# каталог, откуда запускается docker compose (обычно каталог установки ComfyUI)
# UI_COMPOSE_DIR=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/ComfyUI

# --- пути ComfyUI ----------------------------------------------------------
# Корень установки ComfyUI: от него считаются output/, input/, models/loras/.
COMFY_HOME=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/ComfyUI
# COMFY_OUT=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/ComfyUI/output
# COMFY_INPUT=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/ComfyUI/input
# COMFY_LORAS_DIR=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/ComfyUI/models/loras

# --- состояние самой панели ------------------------------------------------
# PANEL_HOME=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ
# UI_HISTORY=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/.ui-history.json

# --- модели -----------------------------------------------------------------
# чем переводить русский текст в промпт и с кем разговаривать в чате
UI_TRANSLATOR=qwen3:8b
# модель со зрением: ею можно спросить «что на картинке»
# UI_VISION_MODEL=qwen3-vl:8b
UI_CHAT_CTX=16384
UI_CHAT_DRAW_MODEL=sdxl
UI_CHAT_DRAW_SIZE=1024x1024

# --- вкладка «железо» ------------------------------------------------------
# какие ещё диски показывать, кроме системного: «метка=точка,метка=точка»
UI_DISKS=/home
# отдельный диск под модели (необязателен): точка монтирования и имя устройства
# UI_SATA_MOUNT=/mnt/aistore
# UI_SATA_DEVICE=/sys/block/sda

# --- вспомогательные вкладки (нужны свои скрипты, см. README) --------------
# TRAINER_DIR=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/trainer
# VIDEO_DIR=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/video-enh
# DOC_SCRIPT=/home/ВАШ_ПОЛЬЗОВАТЕЛЬ/stand-doc.sh
# DOC_UI_IP=172.23.0.10
# DOC_TUNNEL=ssh -N -L 3100:172.23.0.10:8080 user@host
